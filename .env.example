# Needed only for commands that call the model (backtest run, audit run).
OPENAI_API_KEY=sk-...

# Optional. The engine's defaults are what production runs.
# BEBAS_BIAS_MODEL=gpt-6-luna
# BEBAS_BIAS_REASONING_EFFORT=low

# Optional. Defaults read the production site's public data with its
# publishable key; set both to point at a fork's own Supabase project.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
